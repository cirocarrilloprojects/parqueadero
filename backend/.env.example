# Entorno: development | production | test
NODE_ENV=development
# Puerto del API
PORT=3000

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root   # usa un usuario con permisos solo sobre esta BD, no root
DB_PASSWORD=12345678
DB_NAME=parqueadero

# --- Seguridad ---
# Mínimo 32 caracteres. Genera uno: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=28195e68417077f7abc3287e4c04dc046dd942915627ebe99103f15eb659d7c4d7bc50690c68f968805cc5fbaa8308c7
# Horas de vida de la sesión
JWT_EXPIRES_HOURS=8
# true cuando sirvas por HTTPS (producción). La cookie solo viajará cifrada.
COOKIE_SECURE=false
# Origen permitido del frontend en desarrollo (Vite)
CORS_ORIGIN=http://localhost:5173